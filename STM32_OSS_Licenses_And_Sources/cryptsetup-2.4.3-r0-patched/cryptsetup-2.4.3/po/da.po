msgid "Fatal error during RNG initialisation."
msgstr "Fatal fejl under RNG-initialisering."

#: lib/random.c:208
msgid "Unknown RNG quality requested."
msgstr "Der blev anmodt om ukendt RNG-kvalitet."

#: lib/random.c:213
