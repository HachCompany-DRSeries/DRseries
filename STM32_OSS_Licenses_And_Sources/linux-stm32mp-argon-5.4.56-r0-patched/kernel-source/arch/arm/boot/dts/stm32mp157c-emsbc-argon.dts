/dts-v1/;

#include "stm32mp157c-emstamp-argon.dtsi"

/ {
	model = "Hach Lange XMF937A";
	compatible = "Hach Lange,stm32mp157c-XMF937A", "st,stm32mp157";
	
	panel_rgb: panel-rgb {
		compatible = "ampire,am800480r3tmqwa1h";
		status = "okay";
		power-supply = <&v3v3>;
		label = "lcd_panel";
		backlight = <&backlight>;
		enable-gpios = <&gpioj 13 GPIO_ACTIVE_HIGH>;
		port {
			panel_in_rgb: endpoint {
				remote-endpoint = <&ltdc_out_rgb>;			
			};
		};
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm2 0 500000 0>;
		pwm-names = "backlight";
		power-supply = <&v3v3>;
		brightness-levels = <0 255>;
		num-interpolated-steps = <255>;
		default-brightness-level = <250>;

		status = "okay";
	};

	/* On-board camera clock. */
	camera_clk: camera_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};
	
	hl_irq:	hl_irq {
		compatible = "IRQ,Hach-Lange"; 
		gpios = <&gpiob 8 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&gpiog>;
		interrupts = <8 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "hl-irq";
		status = "okay";		
	};

};

&usart2 {
	pinctrl-names = "default", "sleep", "idle";
	pinctrl-0 = <&usart2_pins_mx>;
	pinctrl-1 = <&usart2_sleep_pins_mx>;
	pinctrl-2 = <&usart2_idle_pins_mx>;
	status = "disabled";
};

&usart3 {
	status = "okay";
};

&pinctrl {

	pwm2_pins_b: pwm2-1 {
                pins {
                        pinmux = <STM32_PINMUX('A', 5, AF1)>; /* TIM2_CH1 */
                        bias-pull-down;
                        drive-push-pull;
                        slew-rate = <0>;
                };
        };

        pwm2_sleep_pins_b: pwm2-sleep-1 {
                pins {
                        pinmux = <STM32_PINMUX('A', 5, GPIO)>; /* TIM2_CH1 */
			 output-high;
                };
        };

	
       ltdc_pins_emtrion: ltdc-c-0 {
               pins {
                       //pinmux = <STM32_PINMUX('I', 12, AF14)>, /* LCD_HSYNC */
                       //         <STM32_PINMUX('I', 13, AF14)>, /* LCD_VSYNC */
                       pinmux = <STM32_PINMUX('E', 13, AF14)>, /* LCD_DE */
                                <STM32_PINMUX('J',  1, AF14)>, /* LCD_R2 */
                                <STM32_PINMUX('J',  2, AF14)>, /* LCD_R3 */
                                <STM32_PINMUX('J',  3, AF14)>, /* LCD_R4 */
                                <STM32_PINMUX('J',  4, AF14)>, /* LCD_R5 */
                                <STM32_PINMUX('A',  8, AF14)>, /* LCD_R6 */
                                <STM32_PINMUX('J',  6, AF14)>, /* LCD_R7 */
                                <STM32_PINMUX('H', 13, AF14)>,  /* LCD_G2 */
                                <STM32_PINMUX('J', 12, AF9)>,  /* LCD_G3 */
                                <STM32_PINMUX('H', 15, AF14)>, /* LCD_G4 */
                                <STM32_PINMUX('H',  4, AF9)>,  /* LCD_G5 */
                                <STM32_PINMUX('I',  1, AF14)>, /* LCD_G6 */
                                <STM32_PINMUX('I',  2, AF14)>, /* LCD_G7 */
                                <STM32_PINMUX('J', 14, AF14)>, /* LCD_B2 */
                                <STM32_PINMUX('D', 10, AF14)>, /* LCD_B3 */
                                <STM32_PINMUX('K',  3, AF14)>, /* LCD_B4 */
                                <STM32_PINMUX('K',  4, AF14)>, /* LCD_B5 */
                                <STM32_PINMUX('K',  5, AF14)>, /* LCD_B6 */
                                <STM32_PINMUX('K',  6, AF14)>; /* LCD_B7 */
                       bias-disable;
                       drive-push-pull;
                       slew-rate = <1>;
               };
               pins2 {
                       pinmux = <STM32_PINMUX('E', 14, AF14)>; /* LTDC_CLK */
                       bias-disable;
                       drive-push-pull;
                       slew-rate = <1>;
               };

	};
	
       ltdc_pins_sleep_emtrion: ltdc-c-1 {
               pins {
                       pinmux = <STM32_PINMUX('E', 14, ANALOG)>, /* LTDC_CLK */
                                <STM32_PINMUX('I', 12, ANALOG)>, /* LCD_HSYNC */
                                <STM32_PINMUX('I', 13, ANALOG)>, /* LCD_VSYNC */
                                <STM32_PINMUX('E', 13, ANALOG)>, /* LCD_DE */
                                 <STM32_PINMUX('J',  1, ANALOG)>, /* LCD_R2 */
                                 <STM32_PINMUX('J',  2, ANALOG)>, /* LCD_R3 */
                                 <STM32_PINMUX('J',  3, ANALOG)>, /* LCD_R4 */
                                 <STM32_PINMUX('J',  4, ANALOG)>, /* LCD_R5 */
                                 <STM32_PINMUX('A',  8, ANALOG)>, /* LCD_R6 */
                                 <STM32_PINMUX('J',  6, ANALOG)>, /* LCD_R7 */
                                 <STM32_PINMUX('H', 13, ANALOG)>, /* LCD_G2 */
                                 <STM32_PINMUX('J', 12, ANALOG)>, /* LCD_G3 */
                                 <STM32_PINMUX('H', 15, ANALOG)>, /* LCD_G4 */
                                 <STM32_PINMUX('H',  4, ANALOG)>, /* LCD_G5 */
                                 <STM32_PINMUX('I',  1, ANALOG)>, /* LCD_G6 */
                                 <STM32_PINMUX('I',  2, ANALOG)>, /* LCD_G7 */
                                 <STM32_PINMUX('J', 14, ANALOG)>, /* LCD_B2 */
                                 <STM32_PINMUX('D', 10, ANALOG)>, /* LCD_B3 */
                                 <STM32_PINMUX('K',  3, ANALOG)>, /* LCD_B4 */
                                 <STM32_PINMUX('K',  4, ANALOG)>, /* LCD_B5 */
                                 <STM32_PINMUX('K',  5, ANALOG)>, /* LCD_B6 */
                                 <STM32_PINMUX('K',  6, ANALOG)>; /* LCD_B7 */
               };
       };

	dcmi_pins_mx: dcmi_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('C', 2, AF13)>, /* DCMI_PIXCLK */
					 <STM32_PINMUX('D', 3, AF13)>, /* DCMI_D5 */
					 <STM32_PINMUX('E', 1, AF13)>, /* DCMI_D3 */
					 <STM32_PINMUX('H', 8, AF13)>, /* DCMI_HSYNC */
					 <STM32_PINMUX('H', 9, AF13)>, /* DCMI_D0 */
					 <STM32_PINMUX('H', 10, AF13)>, /* DCMI_D1 */
					 <STM32_PINMUX('H', 11, AF13)>, /* DCMI_D2 */
					 <STM32_PINMUX('H', 14, AF13)>, /* DCMI_D4 */
					 <STM32_PINMUX('I', 5, AF13)>, /* DCMI_VSYNC */
					 <STM32_PINMUX('I', 6, AF13)>, /* DCMI_D6 */
					 <STM32_PINMUX('I', 7, AF13)>; /* DCMI_D7 */
			bias-disable;
		};
	};

	dcmi_sleep_pins_mx: dcmi_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('C', 2, ANALOG)>, /* DCMI_PIXCLK */
					 <STM32_PINMUX('D', 3, ANALOG)>, /* DCMI_D5 */
					 <STM32_PINMUX('E', 1, ANALOG)>, /* DCMI_D3 */
					 <STM32_PINMUX('H', 8, ANALOG)>, /* DCMI_HSYNC */
					 <STM32_PINMUX('H', 9, ANALOG)>, /* DCMI_D0 */
					 <STM32_PINMUX('H', 10, ANALOG)>, /* DCMI_D1 */
					 <STM32_PINMUX('H', 11, ANALOG)>, /* DCMI_D2 */
					 <STM32_PINMUX('H', 14, ANALOG)>, /* DCMI_D4 */
					 <STM32_PINMUX('I', 5, ANALOG)>, /* DCMI_VSYNC */
					 <STM32_PINMUX('I', 6, ANALOG)>, /* DCMI_D6 */
					 <STM32_PINMUX('I', 7, ANALOG)>; /* DCMI_D7 */
		};
	};

	usart2_pins_mx: usart2_mx-0 {
		pins1 {
			pinmux = <STM32_PINMUX('D', 5, AF7)>; /* USART2_TX */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
		pins2 {
			pinmux = <STM32_PINMUX('F', 4, AF7)>; /* USART2_RX */
			bias-disable;
		};
	};

	usart2_idle_pins_mx: usart2_idle_mx-0 {
		pins1 {
			pinmux = <STM32_PINMUX('D', 5, ANALOG)>; /* USART2_TX */
		};
		pins2 {
			pinmux = <STM32_PINMUX('F', 4, AF7)>; /* USART2_RX */
			bias-disable;
		};
	};

	usart2_sleep_pins_mx: usart2_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('D', 5, ANALOG)>, /* USART2_TX */
					 <STM32_PINMUX('F', 4, ANALOG)>; /* USART2_RX */
		};
	};
	adc1_input_pins: adc1_in {
		pins{
			pinmux = <STM32_PINMUX('B', 1, ANALOG)>,
				 <STM32_PINMUX('F', 11, ANALOG)>;
		};
	};

	sdmmc2_b8_pins: sdmmc2-b8 {
		pins1 {
			pinmux = <STM32_PINMUX('B', 14, AF9)>, /* SDMMC2_D0 */
				 <STM32_PINMUX('B', 15, AF9)>, /* SDMMC2_D1 */
				 <STM32_PINMUX('B', 3, AF9)>, /* SDMMC2_D2 */
				 <STM32_PINMUX('B', 4, AF9)>, /* SDMMC2_D3 */
                                 <STM32_PINMUX('E', 4, AF9)>, /* SDMMC2_D4 */
                                 <STM32_PINMUX('A', 15, AF9)>, /* SDMMC2_D5 */
                                 <STM32_PINMUX('C', 6, AF10)>, /* SDMMC2_D6 */
                                 <STM32_PINMUX('C', 7, AF10)>, /* SDMMC2_D7 */
				 <STM32_PINMUX('G', 6, AF10)>; /* SDMMC2_CMD */
			slew-rate = <1>;
			drive-push-pull;
			bias-disable;
		};
		pins2 {
			pinmux = <STM32_PINMUX('E', 3, AF9)>; /* SDMMC2_CK */
			slew-rate = <2>;
			drive-push-pull;
			bias-disable;
		};
	};

	sdmmc2_b8_od_pins: sdmmc2-b8-od {
		pins1 {
			pinmux = <STM32_PINMUX('B', 14, AF9)>, /* SDMMC2_D0 */
				 <STM32_PINMUX('B', 15, AF9)>, /* SDMMC2_D1 */
				 <STM32_PINMUX('B', 3, AF9)>, /* SDMMC2_D2 */
				 <STM32_PINMUX('B', 4, AF9)>, /* SDMMC2_D3 */
                                 <STM32_PINMUX('E', 4, AF9)>, /* SDMMC2_D4 */
                                 <STM32_PINMUX('A', 15, AF9)>, /* SDMMC2_D5 */
                                 <STM32_PINMUX('C', 6, AF10)>, /* SDMMC2_D6 */
                                 <STM32_PINMUX('C', 7, AF10)>; /* SDMMC2_D7 */
			slew-rate = <1>;
			drive-push-pull;
			bias-disable;
		};
		pins2 {
			pinmux = <STM32_PINMUX('E', 3, AF9)>; /* SDMMC2_CK */
			slew-rate = <2>;
			drive-push-pull;
			bias-disable;
		};
		pins3 {
			pinmux = <STM32_PINMUX('G', 6, AF10)>; /* SDMMC2_CMD */
			slew-rate = <1>;
			drive-open-drain;
			bias-disable;
		};
	};

    sdmmc2_b8_sleep_pins: sdmmc2-b8-sleep-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 14, ANALOG)>, /* SDMMC2_D0 */
				 <STM32_PINMUX('B', 15, ANALOG)>, /* SDMMC2_D1 */
				 <STM32_PINMUX('B', 3, ANALOG)>, /* SDMMC2_D2 */
				 <STM32_PINMUX('B', 4, ANALOG)>, /* SDMMC2_D3 */
                 <STM32_PINMUX('E', 4, ANALOG)>, /* SDMMC2_D4 */
                 <STM32_PINMUX('A', 15, ANALOG)>, /* SDMMC2_D5 */
                 <STM32_PINMUX('C', 6, ANALOG)>, /* SDMMC2_D6 */
                 <STM32_PINMUX('C', 7, ANALOG)>, /* SDMMC2_D7 */
				 <STM32_PINMUX('E', 3, ANALOG)>, /* SDMMC2_CK */
				 <STM32_PINMUX('G', 6, ANALOG)>; /* SDMMC2_CMD */
		};
	};
};

&adc {
	pinctrl-names = "default";
	pinctrl-0 = <&adc1_input_pins>;
	vdda-supply = <&vdda>;
	vref-supply = <&vref_adc>;
	status = "okay";
	adc1: adc@0 {
		st,adc-channels = <0>, <1>, <2>, <5>;
		st,min-sample-time-nsecs = <10000>;
		status = "okay";
	};
	adc2: adc@100 {
		status = "disabled";
	};
};

&sdmmc2 {
	arm,primecell-periphid = <0x00253180>;
	//arm,primecell-periphid = <0x10153180>;
	pinctrl-names = "default", "opendrain", "sleep";
	pinctrl-0 = <&sdmmc2_b8_pins>;
	pinctrl-1 = <&sdmmc2_b8_od_pins>;
	pinctrl-2 = <&sdmmc2_b8_sleep_pins>;
	non-removable;
	st,neg-edge;
	bus-width = <8>;
	vmmc-supply = <&v3v3>;
	#address-cells = <1>;
	#size-cells = <0>;
	keep-power-in-suspend;
	mmc-ddr-3_3v;
	status = "okay";
};

&sdmmc1 {
	status = "disabled";
};

&i2c1 {

	status = "okay";

	mt9v022@4c {
		compatible = "aptina,mt9v022m";
		reg = <0x4c>;
		reset-gpios = <&gpiob 13 GPIO_ACTIVE_HIGH>;
		enable-gpios = <&gpioh 2 GPIO_ACTIVE_HIGH>;
		clocks = <&camera_clk>;
		status = "okay";

		port {
			mt9v022_0: endpoint {
				remote-endpoint = <&dcmi_0>;
				bus-width = <8>;
                       	bus-type = <5>;
                       	hsync-active = <0>;
                       	vsync-active = <0>;
                       	pclk-sample = <0>;
			};
		};
	};
};

&dcmi {
	status = "okay";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&dcmi_pins_mx>;
	pinctrl-1 = <&dcmi_sleep_pins_mx>;

	port {
		dcmi_0: endpoint {
			remote-endpoint = <&mt9v022_0>;
			bus-type = <5>;
			bus-width = <8>;
       		hsync-active = <0>;
       		vsync-active = <0>;
       		pclk-sample = <1>;
		};
	};
};


&dsi {
	status = "disabled";
};

&ltdc {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&ltdc_pins_emtrion>;
	pinctrl-1 = <&ltdc_pins_sleep_emtrion>;
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		ltdc_out_rgb: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&panel_in_rgb>;
		};
	};
};

&timers2 {
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";
	pwm2: pwm {
		pinctrl-0 = <&pwm2_pins_b>;
		pinctrl-1 = <&pwm2_sleep_pins_b>;
		pinctrl-names = "default", "sleep";
		status = "okay";
	};
};

&rtc {
//	st,lsco = <RTC_OUT2_RMP>;
//	pinctrl-0 = <&rtc_out2_rmp_pins_a>;
//	pinctrl-names = "default";
};

/* enable for usb 1.1 low speed */
&usbh_ohci {
	phys = <&usbphyc_port0>;
	vbus-supply = <&vdd_usb>;
	phy-names = "usb";
	status = "okay";
};

&spi1 {
        pinctrl-names = "default", "sleep";
        pinctrl-0 = <&spi1_pins_a>;
        pinctrl-1 = <&spi1_sleep_pins_a>;
        cs-gpios = <&gpioz 3 0>;
        status = "okay";
        spidev@0  {
               compatible = "analog,ltc2440";
               reg = <0>;
               spi-max-frequency = <10000000>;
	       status = "okay";
        };
};
